<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.personal.studytracker.identity.ui.newPasswordController">
    <children>
        <ImageView fitHeight="629.0" fitWidth="1226.0" layoutX="-868.0" layoutY="-10.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../assets/images/bg.jpg" />
            </image></ImageView>
        <AnchorPane layoutX="358.0" layoutY="-10.0" prefHeight="613.0" prefWidth="442.0">
            <children>
                <Label layoutX="79.0" layoutY="136.0" style="-fx-font-weight: bold;" text="Reset Password" textOverrun="CLIP">
                    <font>
                        <Font name="Inter Semi Bold" size="35.0" />
                    </font>
                </Label>
                <Label layoutX="79.0" layoutY="187.0" text="Enter your new password." textFill="#666666">
                    <font>
                        <Font name="Inter Regular" size="12.0" />
                    </font>
                </Label>
                <Button fx:id="findUsername" layoutX="102.0" layoutY="509.0" mnemonicParsing="false" onAction="#handleResetPassword" prefHeight="36.0" prefWidth="239.0" style="-fx-background-color: #a16262; -fx-background-radius: 7px;" text="Reset Password" textFill="WHITE" textOverrun="WORD_ELLIPSIS">
                    <font>
                        <Font name="Inter Regular" size="13.0" />
                    </font>
                </Button>
                <Hyperlink layoutX="182.0" layoutY="557.0" onAction="#handleCancel" text="Back to Login" textFill="#a16262">
                    <font>
                        <Font name="Inter Regular" size="11.0" />
                    </font>
                </Hyperlink>
                <VBox layoutX="57.0" layoutY="233.0" prefHeight="240.0" prefWidth="329.0" spacing="15.0">
                    <children>
                        <Label fx:id="seurityQuestionLabel" style="-fx-font-weight: bold;" text="New password">
                            <font>
                                <Font name="Inter Semi Bold" size="13.0" />
                            </font>
                        </Label>
                  <PasswordField fx:id="newPasswordField" prefHeight="40.0" prefWidth="297.0" promptText="New Password" style="-fx-background-radius: 7px; -fx-focus-color: #a16262;">
                     <font>
                        <Font name="Inter Regular" size="13.0" />
                     </font>
                  </PasswordField>
                  <Label style="-fx-font-weight: bold;" text="Confirm password">
                     <font>
                        <Font name="Inter Semi Bold" size="13.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="confirmPasswordField" prefHeight="40.0" prefWidth="297.0" promptText="Confrim Password" style="-fx-background-radius: 7px; -fx-focus-color: #a16262;">
                     <font>
                        <Font name="Inter Regular" size="13.0" />
                     </font>
                  </PasswordField>
                        <Label style="-fx-font-weight: bold;">
                            <font>
                                <Font name="Inter Semi Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
